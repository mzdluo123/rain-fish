# Copy to .env and edit. Bun loads .env automatically (no dotenv needed); real environment variables win.
# Everything is validated at startup (src/qq/schemas.ts) - a bad value prints a readable error and exits.

# --- QQ / NapCat (OneBot v11) ---
# WebSocket URL of NapCat's WebSocket server. This program connects to it as a client.
QQ_WS_URL=ws://127.0.0.1:3001
# NapCat access token, if you set one (sent as "Authorization: Bearer ..."). Leave empty for none.
QQ_TOKEN=
# Only handle these group ids (comma separated). Leave empty to handle every group the bot is in.
QQ_GROUPS=

# --- System prompt ---
# Host file used verbatim as the agent's system prompt (the agent itself cannot read or change it).
# Read when a group's conversation starts; restart to apply an edit everywhere.
PROMPT_FILE=prompts/agent.md
# Host file copied to the agent's /persona.md (its pinned self-profile) when the database has none yet.
# After that the agent owns the file; editing this one does not change an existing profile.
PERSONA_SEED_FILE=prompts/persona.md

# --- State ---
# The single SQLite file holding messages, the agent's filesystem and the schema version.
DB_PATH=data/bot.db

# --- Model ---
# provider/model-id, e.g. anthropic/claude-sonnet-4-5 or openai/gpt-5.5. Empty: the default model from Pi's own
# settings (~/.pi/agent/settings.json). Startup fails with a list of known models if it does not exist.
# A model that accepts images keeps compacted history as bitmap frames; others get a text archive.
MODEL=
# Thinking effort: off | minimal | low | medium | high | xhigh | max. Empty: Pi's default (medium, clamped to what the model supports).
# Models missing from Pi's catalog can be declared in ~/.pi/agent/models.json.
THINKING_LEVEL=
# How long the provider keeps the cached prompt prefix (the system prompt + history are re-sent on every wake-up; a cache hit costs ~10% of
# the input price). long = 1 hour (Anthropic; other providers use their longest tier or ignore it), short = the provider default (5 minutes).
# A 1-hour cache write costs about twice a 5-minute one, which pays off when a group is woken less often than every 5 minutes.
CACHE_RETENTION=long

# --- Context management (all values are tokens, estimates; the defaults suit a ~128k-context model; raise them for larger windows, e.g. RECENT=40000 COMPACT=200000 ARCHIVE=60000 for 1M) ---
# The context only shrinks by snap compaction (oh-my-pi's snapcompact): when it passes COMPACT, everything older than the
#   RECENT window is rendered into bitmap frames (no LLM call) that replace it; ARCHIVE is the frames' token budget.
#   Nothing else is cleared from the history: pictures are scaled down when they enter (IMAGE_MODEL_MAX_PIXELS), the agent's
#   profile (/persona.md) is pinned outside the history, and the archive leaves out protocol notices and the profile's files.
# RECENT + ARCHIVE must stay below COMPACT. Values tuned for Haiku 5.5 (input price x5 above 100k tokens per request, so COMPACT stays under that).
CONTEXT_RECENT_TOKENS=16000
CONTEXT_COMPACT_TOKENS=80000
CONTEXT_ARCHIVE_TOKENS=20000
# Memory flush: once the context passes this fraction of COMPACT (0 < ratio < 1), the agent gets one extra turn to save
#   what matters to its .md files (it may not send) before the old history is compacted away. Once per compaction cycle.
CONTEXT_FLUSH_RATIO=0.85
# Compaction after the prompt cache has expired: if more than TTL seconds passed since a group's last model request, its cache is gone and the
#   next request re-writes the whole prefix anyway, so at the start of the run the WHOLE live context is snap-compacted (lossless, no LLM call, no memory flush)
#   - but only if that saves at least MIN_SAVED_TOKENS and MIN_SAVED_RATIO of the request (otherwise nothing changes). TTL is its own setting: match it
#   to the provider (Anthropic: 300 short / 3600 long; keep it in line with CACHE_RETENTION). Not used while the cache is still alive.
CACHE_COMPACT_ENABLED=true
CACHE_COMPACT_TTL_SECONDS=3600
CACHE_COMPACT_MIN_SAVED_TOKENS=8000
CACHE_COMPACT_MIN_SAVED_RATIO=0.4
# If compacting would save too little (e.g. the archive is already full and little is live), forget the WHOLE context instead - live messages AND
#   the archive (the chat log, files and /persona.md stay; this part is NOT lossless) - but only if that clears the same two minimums.
CACHE_COMPACT_CLEAR_FALLBACK=true

# --- Wake-ups ---
# Messages do not each trigger a model call. Per group, pending messages are handled together when a wake-up fires.
# The wake-up time is modelled with a Hawkes process (src/wake-intensity.ts): every message excites the chat, the excitation
# fades exponentially, and the agent waits until it has fallen below a threshold (the burst is over), so a busy chat is not
# interrupted and a lone question is answered soon. A random reaction time (exponential, means below, seconds) is added on top:
# CHAT applies to ordinary chatter; ADDRESSED once a pending message @-mentions the bot or replies to it (0 = no extra delay).
# Questions and messages to the bot excite less (answer sooner), unfinished sentences more (wait for the rest).
WAKE_CHAT_MEAN_SECONDS=45
WAKE_ADDRESSED_MEAN_SECONDS=1
# beta (per second): decay of the excitation; the half-life is ln 2 / beta (0.4 -> ~1.7 s).
WAKE_DECAY_PER_SECOND=0.4
# The chat is "quiet" when the excitation is down to this many ordinary messages. One message alone: ln(1/0.3)/0.4 = ~3 s of quiet.
WAKE_QUIET_THRESHOLD=0.3
# Upper bounds, counted from the first pending message / the first addressed one, however busy the chat stays; and the
# number of pending messages that wakes the agent at once.
WAKE_MAX_WAIT_SECONDS=120
WAKE_ADDRESSED_MAX_WAIT_SECONDS=20
WAKE_MAX_BATCH=30
# Every this many agent runs of a group, the next batch carries a system notice "you must say something" (and a reminder
# turn follows if the agent still did not call `send`). Only successful runs count; the count is kept in the database. 0 = never.
SPEAK_EVERY_RUNS=3

# --- History backfill ---
# At startup (once connected), a group with fewer than MIN_MESSAGES stored messages gets its recent history pulled from
# NapCat (get_group_msg_history): newest first, page by page, keeping only messages from the last MAX_AGE_DAYS days,
# until MIN_MESSAGES of those are collected or no more exist. They are stored and searchable; they do not wake the agent.
# Without QQ_GROUPS every group the bot is in is checked. MIN_MESSAGES=0 turns the backfill off.
BACKFILL_MIN_MESSAGES=100
BACKFILL_MAX_AGE_DAYS=5

# --- Images ---
# Pictures in group messages are downloaded when the agent is woken (not before) and attached to its prompt; needs a
# model that accepts images (otherwise they stay a "[图片]" placeholder). Only HTTPS URLs on QQ's own hosts are fetched.
# Photos, stickers and market stickers are all sent automatically (the newest MAX_PER_RUN different ones of a wake-up). A picture enters the
# context ONCE: one already there (an earlier wake-up, or seen through view_image) is not attached again - the message only names its id.
# Pictures stay in the model's context (scaled down) until compaction, which keeps only the text placeholder; after that they may be attached again.
# MAX_BYTES=0 or MAX_PER_RUN=0 turns images off.
IMAGE_MAX_BYTES=3145728
IMAGE_MAX_PER_RUN=8
# Pictures of incoming messages are downloaded when they arrive and kept in the database, so the agent can look at them
# (`view_image`) and re-send them (`send_image`) after QQ's URL expired. Total size cap; the least recently used pictures
# are deleted first, and the database file is shrunk to match. 0 = pictures are not kept (the agent then only sees them when woken, as above).
IMAGE_STORE_MAX_BYTES=209715200
# What the MODEL sees is a scaled-down copy (the stored original is untouched, `send_image` posts the original): same aspect
# ratio, never enlarged, at most this many pixels and this long a side. Tokens are about pixels / 750, so 800000 px ~ 1100
# tokens (a 4000x3000 photo becomes ~1033x775). Lower = cheaper but less detail (small text goes first); `bun run
# image-preview <picture>` writes a picture at several budgets so you can judge what survives. 0 = no scaling.
IMAGE_MODEL_MAX_PIXELS=800000
IMAGE_MODEL_MAX_EDGE=1568
# `view_image` with detail=true uses this budget instead.
IMAGE_DETAIL_MAX_PIXELS=1150000

# --- What the agent posts ---
# `send` / `send_image` may be called several times per run; `stop` ends the run.
# Most messages per run (more are refused until the next wake-up), and the pause before the 2nd and later ones (ms).
SEND_MAX_PER_RUN=6
SEND_GAP_MS=800

# --- Python on Google Colab (`run_python`) ---
# Gives the agent `run_python`: a .py file of its filesystem runs on a Google Colab CPU machine. Nothing runs on this host:
# the `colab` CLI (google-colab-cli, `uv tool install google-colab-cli`) ships the file's text to the remote kernel.
# Log the CLI in once by hand first (e.g. run `colab new` and `colab stop` in a terminal); the bot never starts a login flow.
# One machine is shared by all groups, runs are executed one at a time. It is created by the first run and released after
# COLAB_IDLE_SECONDS without one (also on shutdown, and at startup if the last process left one behind). The machine can
# reach the internet and runs under your Google account: group members can steer what the agent writes.
COLAB_ENABLED=false
COLAB_CLI_PATH=colab
# oauth2 | adc (empty = the CLI's default)
COLAB_AUTH=
COLAB_SESSION_NAME=rain-fish
# Wall-clock limit of one run (the agent may pick up to the max); the script and everything it started are killed after it.
COLAB_EXEC_TIMEOUT_SECONDS=60
COLAB_EXEC_MAX_TIMEOUT_SECONDS=300
COLAB_IDLE_SECONDS=900
COLAB_CREATE_TIMEOUT_SECONDS=180
# Per stream (stdout / stderr): at most this many bytes come back (head + tail). The agent may ask for more in one call
# (`max_output_bytes`, up to 64 KiB); all of it enters its context.
COLAB_OUTPUT_MAX_BYTES=8000
# Runs per agent run, and per hour for all groups together.
COLAB_EXEC_MAX_PER_RUN=3
COLAB_EXEC_MAX_PER_HOUR=30
# Tavily search key for scripts run through `run_python`. It is given to the script as the environment variable TAVILY_API_KEY
# (os.environ["TAVILY_API_KEY"]); it is never an argument, never shown to the agent, and is masked as [REDACTED] in script output.
# TAVILY_API_KEY=

# --- Execution trace (structured event log, JSON lines) ---
# What the agent did and how each group moved between states: queueing, wake-ups, runs, model calls with token usage
# and cost, tool calls, flush/compaction, sends. For observability and debugging; see README "Observability".
# The live file is DIR/agent.jsonl; it is rotated by size and by day, rotated files are gzipped and pruned by count/age.
TRACE_ENABLED=true
TRACE_DIR=data/logs
TRACE_MAX_FILE_MB=20
TRACE_MAX_FILES=30
TRACE_MAX_AGE_DAYS=14
TRACE_COMPRESS=true
# false: only sizes, ids and names are recorded. true: also message text, prompts, tool arguments and results (clipped).
TRACE_CONTENT=false

# --- Logging ---
# silent | error | warn | info | debug   (debug also logs every stored message and each tool call)
LOG_LEVEL=info

# --- Model credentials (read by Pi, not by this program) ---
# Or run `pi` once and log in; credentials are then kept in ~/.pi/agent.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
